@model MOBILE_PHONE.Models.Users;

@{
    ViewData["Title"] = "Connexion";
    Layout = "_AuthenticationLayout";
    var successMessage = TempData["SuccessMessage"] as string;
}

@if(!string.IsNullOrEmpty(successMessage)){
    <div class="alert alert-success">
        <p>@successMessage</p>
    </div>
}

@if(ViewData["Error"] != null){
    <div class="alert alert-error">
        <p>@ViewData["Error"]</p>
    </div>
}

<main class="form-container">
    <form asp-action="Login" method="POST">
        <h3>Connexion</h3>
        <div class="form-element">
            <label for="Email">Email :</label>
            <input type="email" id="Email" name="Email" required placeholder="user@example.com" asp-for="Email"/>
        </div>
        <div class="form-element">
            <label for="Password">Password :</label>
            <input type="password" id="Password" name="Password" required placeholder="votre mot de passe" asp-for="Password"/>
        </div>
        <div class="button-container">
            <button>connexion</button>
            <a asp-action="ForgotPassword">
                <p>Mot de passe oublié?</p>
            </a>
        </div>
    </form>    
</main>