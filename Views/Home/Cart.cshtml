@{
    ViewData["Title"] = "Cart";
}

<header class="cart">
    <nav>
        <div class="logo-container">
                <h2>LOGO</h2>
            </div>
            <ul>
                <li>
                    <a asp-action="Cart">
                        <img src="~/img/cart.png"/>    
                    </a>
                </li>
                <li>
                    <a asp-action="Index">
                        Accueil
                    </a>
                </li>
                <li>
                    <a asp-controller="Authentication" asp-action="Login">
                        <button>Se connecter</button>
                    </a>
                </li>
            </ul>    
        </nav>
</header>
<main class="cart-product">
    <table>
            <tr>
                <th style="width: 5%;">Illustrations</th>
                <th style="width: 20%;">Marque et Modèle</th>
                <th style="width: 20%;">Prix et Stock</th>
                <th style="width: 10%;">Actions</th>
            </tr>
            <tr>
                <td class="product-img">
                    <img src="~/img/product (5).jpg"/>
                </td>
                <td>
                    <p class="mark-model">
                        Redmi : 4X
                    </p>    
                </td>
                <td>
                    <p class="price">
                        699,000 Ar
                    </p>
                </td>
                <td>
                    <p class="actions">
                        <span class="edit">
                            <img src="~/img/edit.png"/>
                        </span>
                        <span class="delete">
                            <img src="~/img/delete.png"/>
                        </span>
                    </p>    
                </td>
            </tr>
            <tr>
                <td class="product-img">
                    <img src="~/img/product (9).jpg"/>
                </td>
                <td>
                    <p class="mark-model">
                        Redmi : 4X
                    </p>    
                </td>
                <td>
                    <p class="price">
                        699,000 Ar
                    </p>
                </td>
                <td>
                    <p class="actions">
                        <span class="edit">
                            <img src="~/img/edit.png"/>
                        </span>
                        <span class="delete">
                            <img src="~/img/delete.png"/>
                        </span>
                    </p>    
                </td>
            </tr>
        </table>
</main>
