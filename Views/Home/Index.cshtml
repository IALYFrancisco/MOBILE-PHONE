@model IEnumerable<MOBILE_PHONE.Models.Products>
@{
    ViewData["Title"] = "Accueil";
    Layout = "_Layout";
}
<header class="home">
    <nav>
        <div class="logo-container">
                <h2>LOGO</h2>
            </div>
            <ul>
                @if(User.Identity?.IsAuthenticated ?? false){
                    <li>
                        <a asp-action="Cart">
                            <img src="~/img/cart.png"/>    
                        </a>
                    </li>
                }
                <li>
                    <a asp-action="Index">
                        Accueil
                    </a>
                </li>
                @if(User.Identity?.IsAuthenticated ?? false){
                    <li>
                        <form asp-action="Logout" asp-controller="Authentication" method="POST">
                            <button>Se déconnecter</button>
                        </form>
                    </li>
                }else{
                    <li>
                        <a asp-controller="Authentication" asp-action="Login">
                            <button>Se connecter</button>
                        </a>
                    </li>
                }
            </ul>    
        </nav>        
        <section class="couvercle">
            <video src="~/movies/Introducing iPhone 16 Pro - Apple.mp4" autoplay muted loop></video>
        </section>        
</header>
<main class="products">
    @foreach (var product in Model){
        <div class="product">
            <div class="img-container">
                <img src="~/img/product (1).jpg"/>
            </div>
            <div class="product-info">
                <p class="name">@product.Mark @product.Model</p>    
                <p class="price">@product.UnitPrice Ar</p>
                <p class="stars">
                    <img src="~/img/star.png"/>
                    <img src="~/img/star.png"/>
                    <img src="~/img/star.png"/>
                    <img src="~/img/star.png"/>
                    <img src="~/img/star.png"/>
                </p>
            </div>
            <div class="actions">
                @if(User.Identity?.IsAuthenticated ?? false){
                    <button>ajouter au panier</button>
                }else{
                    <button class="disconnected">ajouter au panier</button>
                }
            </div>
        </div>
    }
</main>