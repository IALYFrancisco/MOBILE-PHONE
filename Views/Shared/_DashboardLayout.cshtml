@{
    Layout = "_Layout";
}
<main class="container">
    <aside>
        <nav>
            <ul>
                <li>
                    <a asp-action="Index">
                        <img src="~/img/Home.png"/>
                    </a>
                </li>
                <li>
                    <a asp-action="Product">
                        <img src="~/img/product.png" alt="product" title="product"/>
                    </a>
                </li>
            </ul>
        </nav>
    </aside>
    <main class="render-container">
        @RenderBody()
    </main>
</main>