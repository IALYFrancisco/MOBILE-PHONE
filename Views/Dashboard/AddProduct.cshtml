@{
    ViewData["Title"] = "Ajout de produit";
    Layout = "_DashboardLayout";
}

<section class="dashboard-form-container">
    <h2>Ajout de produit</h2>
    <form>
        <div class="element">
            <label for="Mark">Marque</label>
            <input type="text" id="Mark" name="Mark" required/>
        </div>
        <div class="element">
            <label for="Model">Modèle</label>
            <input type="text" id="Model" name="Model" required/>
        </div>
        <div class="element">
            <label for="Stock">Stock</label>
            <input type="number" id="Stock" name="Stock" required/>
        </div>
        <div class="element">
            <label for="Unit_Price">Prix unitaire (Ar)</label>
            <input type="number" id="Unit_Price" name="Unit_Price" required/>
        </div>
        <div class="element">
            <label for="Image">Illustration</label>
            <input type="text" id="Image" name="Image" required/>
        </div>
        <div class="button-container">
            <button>Ajouter</button>
        </div>
    </form>
</section>