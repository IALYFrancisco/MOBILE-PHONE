@model MOBILE_PHONE.Models.Products;

@{
    ViewData["Title"] = "Ajout de produit";
    Layout = "_DashboardLayout";
}

<section class="dashboard-form-container">
    <h2>Ajout de produit</h2>
    <form asp-action="AddProduct" method="POST">
        <div class="element">
            <label for="Mark">Marque</label>
            <input type="text" id="Mark" name="Mark" required asp-for="Mark"/>
        </div>
        <div class="element">
            <label for="Model">Modèle</label>
            <input type="text" id="Model" name="Model" required asp-for="Model"/>
        </div>
        <div class="element">
            <label for="Stock">Stock</label>
            <input type="number" id="Stock" name="Stock" required asp-for="Stock"/>
        </div>
        <div class="element">
            <label for="UnitPrice">Prix unitaire (Ar)</label>
            <input type="number" id="UnitPrice" name="UnitPrice" required asp-for="UnitPrice"/>
        </div>
        <div class="element">
            <label for="Image">Illustration</label>
            <input type="text" id="Image" name="Image" required asp-for="Image"/>
        </div>
        <div class="button-container">
            <button>Ajouter</button>
        </div>
    </form>
</section>