@{
    ViewData["Title"] = "Product";
    Layout = "_DashboardLayout";
    var successMessage = TempData["SuccessMessage"] as string;
}

@if(!string.IsNullOrEmpty(successMessage)){
    <div class="alert alert-success">
        <p>@successMessage</p>
    </div>
}

<section class="product-container">
    <h2>Produits</h2>
    <section class="actions">
        <a asp-action="AddProduct">
            <button>Ajouter un produit</button>
        </a>
    </section>
    <section class="table-container">
        <table>
            <tr>
                <th style="width: 10%;">Illustrations</th>
                <th style="width: 20%;">Marque et Modèle</th>
                <th style="width: 20%;">Prix et Stock</th>
                <th style="width: 20%;">Révenus</th>
                <th style="width: 20%;">Dates d'ajout</th>
                <th style="width: 10%;">Actions</th>
            </tr>
            @foreach(var product in Model){
                <tr>
                    <td class="product-img">
                        <img src="~/img/product (1).jpg"/>
                    </td>
                    <td>
                        <p class="mark">Marque: @product.Mark</p>    
                        <p class="model">Modèle: @product.Model</p>
                    </td>
                    <td>
                        <p class="price">Prix unitaire: @product.UnitPrice Ar</p>    
                        <p class="stock">Stock: @product.Stock / 50</p>
                    </td>
                    <td>
                        <p class="benefits">284,628,779,927,492 Ar</p>    
                    </td>
                    <td>
                        <p class="add-date">@product.RegisterDate.ToString("dd - MM - yyyy")</p>    
                    </td>
                    <td>
                        <p class="actions">
                            <span class="edit">
                                <img src="~/img/edit.png"/>
                            </span>
                            <span class="delete">
                                <img src="~/img/delete.png"/>
                            </span>
                        </p>    
                    </td>
                </tr>
            }
        </table>
    </section>
</section>